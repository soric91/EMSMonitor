# Sin `/api/v1` al final: el cliente lo agrega. El puerto 8000 suele estar
# ocupado por CRMBackend en la misma máquina, de ahí el 8001.
PUBLIC_API_BASE_URL=http://localhost:8001
PUBLIC_WS_URL=ws://localhost:8001/ws
# CRMBackend emite la identidad: el login va contra él, no contra ApiEMS.
PUBLIC_CRM_BASE_URL=http://localhost:8000
